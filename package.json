  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cost",
    "usage",
    "billing"
  ],
  "license": "MIT",
  "author": "muti2607",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muti2607/dsh-session-cost.git"
  },
  "bugs": {
    "url": "https://github.com/muti2607/dsh-session-cost/issues"
  },
  "homepage": "https://github.com/muti2607/dsh-session-cost#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
